# VeriChain Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas Cluster URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/verichain?retryWrites=true&w=majority

# JSON Web Token Secret (Use a secure 32+ character random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Allowed CORS Origins (comma-separated URLs, include your Vercel deployment URL)
ALLOWED_ORIGINS=http://localhost:5173,https://your-verichain-app.vercel.app

# Cloudinary Storage Configuration (Optional - for product media & certificate uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
